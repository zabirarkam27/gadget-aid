# MongoDB Atlas
DB_USER=your_mongodb_username
DB_PASSWORD=your_mongodb_password

# Server
PORT=5000
NODE_ENV=development

# Allowed frontend origins (comma-separated, no spaces around commas needed)
CORS_ORIGINS=http://localhost:5173,https://gadget-aid.web.app

# Firebase Admin SDK — from Firebase Console > Project Settings > Service Accounts
# > Generate new private key (downloads a JSON file, copy the 3 fields below from it)
FB_PROJECT_ID=your-firebase-project-id
FB_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Phase 7 transactional email (server only; leave blank to disable delivery)
# Use a verified sender domain. APP_URL must be the frontend origin.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5173
# At least 32 random characters. An external scheduler calls GET /internal/jobs/email
# with Authorization: Bearer <CRON_SECRET>. Never expose this to VITE_* variables.
CRON_SECRET=

# Optional endpoint for npm run email:deliver; remote endpoints must use HTTPS.
EMAIL_JOB_URL=http://localhost:5000/internal/jobs/email

# Optional trusted moderation CLI identity; never used to grant an app role.
MODERATION_OPERATOR=
# Enable only for a reviewed hide/restore invocation by an authorized DB operator.
MODERATION_ALLOW_WRITE=
